# Copy to .env (gitignored) and fill in. Never commit real values.
WAZUH_INDEXER_URL=https://<WAZUH_IP>:9200
WAZUH_USER=<indexer-user>
WAZUH_PASS=<indexer-password>
# Victim hostname == Wazuh agent name. Harness aborts unless it matches.
LAB_VICTIM_HOSTNAME=<victim-hostname>
# true | false | path to Wazuh root-ca.pem
TLS_VERIFY=false
